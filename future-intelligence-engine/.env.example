POSTGRES_PASSWORD=fiepass
POSTGRES_DB=fie_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fie:fiepass@localhost:5432/fie_db

# === Qdrant ===
